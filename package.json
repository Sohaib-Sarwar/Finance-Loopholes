{
  "name": "combined-mf-bank-roi-calculator",
  "private": true,
  "version": "2.0.0",
  "description": "Combined Mutual Fund + Bank ROI Calculator - production PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "publish:root": "node scripts/publish-to-root.mjs",
    "release": "npm run build && npm run publish:root",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.4.4",
    "lucide": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "sharp": "^0.35.4",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
