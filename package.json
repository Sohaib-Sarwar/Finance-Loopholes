{
  "name": "combined-mf-bank-roi-calculator",
  "private": true,
  "version": "1.0.0",
  "description": "Combined Mutual Fund + Bank ROI Calculator - production PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:subpath": "vite preview --base=/Finance-Loopholes/",
    "test": "vitest run",
